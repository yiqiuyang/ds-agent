{
  "name": "ds-agent",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) 插件化智能体的桌面外壳",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "build": {
    "appId": "app.dsagent.desktop",
    "productName": "ds-agent",
    "extraResources": [
      {
        "from": "vendor/dsh",
        "to": "dsh"
      }
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
